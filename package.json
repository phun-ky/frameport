{
  "name": "@phun-ky/frameport",
  "version": "2.0.90",
  "description": "A zero dependency package to effortlessly create responsive component previews in documentation using real media queries. Frameport dynamically generates iframes containing your HTML/CSS/JS, mimicking natural device viewports to test responsiveness, without any build steps or dependencies.",
  "keywords": [
    "documentation",
    "style guide",
    "styleguide",
    "design system",
    "media queries",
    "responsive",
    "documentation helpers",
    "javascript",
    "css",
    "html",
    "viewport",
    "frame",
    "iframes",
    "iframe",
    "component",
    "frameport",
    "component documentation",
    "responsive design",
    "responsive preview",
    "breakpoints",
    "screen sizes",
    "live preview",
    "component demo",
    "web components",
    "zero dependency",
    "sandbox",
    "playground",
    "visual testing",
    "devtools",
    "framework agnostic",
    "embed",
    "browser preview",
    "UI preview",
    "storybook alternative"
  ],
  "homepage": "https://github.com/phun-ky/frameport#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/frameport/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/frameport.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander+frameport@phun-ky.net>",
  "type": "module",
  "main": "./dist/frameport.esm.js",
  "module": "./dist/frameport.esm.js",
  "types": "./dist/frameport.d.ts",
  "exports": {
    ".": {
      "types": "./dist/frameport.d.ts",
      "default": "./dist/frameport.esm.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "unpkg": "./dist/frameport.js",
  "jsdelivr": "./dist/frameport.js",
  "files": [
    "/dist/frameport.esm.js",
    "/dist/frameport.esm.js.map",
    "/dist/frameport.js",
    "/dist/frameport.js.map",
    "/dist/frameport.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run rollup",
    "check:pack": "node scripts/check-pack.mjs",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "clean": "rm -rf dist dts",
    "commit": "npx git-cz",
    "dev": "npx browser-sync start --server 'dev' --files 'dist' --ss 'dist'",
    "docs:gen": "node ./node_modules/.bin/typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "prepare": "git config core.hooksPath .githooks || true",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "rollup": "rollup -c",
    "prerollup:dev": "npm run clean",
    "rollup:dev": "rollup -c -w",
    "style:code": "npx putout src",
    "style:format": "eslint . --fix",
    "style:format-check": "prettier --check '**/*.{json,yml,yaml}'",
    "style:lint": "eslint .",
    "test": "node --import tsx --import global-jsdom/register --test --enable-source-maps 'src/**/__tests__/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "node --import tsx --import global-jsdom/register --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/types/**' --test-coverage-lines=99 --test-coverage-functions=100 --test-coverage-branches=95 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout 'src/**/__tests__/**/*.ts'"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "global-jsdom": "^29.0.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.0",
    "publint": "^0.3.25",
    "putout": "^42.13.0",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.3.1",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typedoc-plugin-remark": "^2.0.0",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typescript": "^6.0.3",
    "unified-prettier": "^2.0.1"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.1",
      "basic-ftp": "^6.2.3"
    }
  }
}
