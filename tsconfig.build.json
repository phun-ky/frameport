{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "./dts",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["**/__tests__/**"]
}
